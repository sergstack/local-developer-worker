{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageBPhase1PortfolioItem",
  "type": "object",
  "required": ["id", "objective", "initial_status", "evidence_test_ids", "owner_action"],
  "properties": {
    "id": {"enum": ["POLICY-01", "REF-01", "GATE-01", "GATE-02", "GATE-03", "GATE-04", "GATE-05", "GATE-06", "GATE-07", "NR-01"]},
    "objective": {"type": "string", "minLength": 1},
    "initial_status": {"enum": ["not_started", "inputs_pending", "ready", "in_progress", "qa_pending", "judge_revise", "waiting_for_input", "waiting_for_owner", "complete", "failed", "blocked", "stopped"]},
    "evidence_test_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^tests/[^:]+::test_\\S+$"}
    },
    "owner_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
