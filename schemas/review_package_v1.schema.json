{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "review_package_id", "objective", "diagnosis", "review_profile", "affected_invariants", "affected_boundaries", "required_checks", "findings", "unknowns", "evidence_refs", "derived_view_plan", "authority", "evidence_export"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "review_package_id": {"type": "string", "pattern": "^REVIEW_[0-9A-F]{12}$"},
    "objective": {"type": "string"},
    "diagnosis": {"type": "object", "additionalProperties": false, "required": ["review_profile", "activation_reasons", "deterministic"], "properties": {"review_profile": {"enum": ["local", "contract_change", "cross_boundary", "evidence_risk"]}, "activation_reasons": {"type": "array", "items": {"type": "string"}}, "deterministic": {"const": true}}},
    "review_profile": {"enum": ["local", "contract_change", "cross_boundary", "evidence_risk"]},
    "affected_invariants": {"type": "array", "items": {"type": "string"}},
    "affected_boundaries": {"type": "array", "items": {"type": "string"}},
    "required_checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["finding_id", "kind", "status", "evidence_state", "evidence_refs"], "properties": {"finding_id": {"type": "string", "pattern": "^FINDING_[A-Z][A-Z0-9_-]{0,63}$"}, "kind": {"const": "required_check_status"}, "status": {"enum": ["passed", "failed", "not_run", "unknown"]}, "evidence_state": {"enum": ["observed", "not_run", "unknown"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}}}}},
    "unknowns": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}},
    "derived_view_plan": {"type": "object", "additionalProperties": false, "required": ["views", "rendering", "authoritative_input"], "properties": {"views": {"type": "array", "items": {"type": "string"}}, "rendering": {"const": "not_in_p0"}, "authoritative_input": {"const": "caller_retained_evidence"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["evidence_manifest_authoritative", "review_package_status", "promotion_authority", "model_invoked", "source_mutation", "root_cause_inferred"], "properties": {"evidence_manifest_authoritative": {"const": true}, "review_package_status": {"const": "derived"}, "promotion_authority": {"const": "human_or_ai_os_only"}, "model_invoked": {"const": false}, "source_mutation": {"const": false}, "root_cause_inferred": {"const": false}}},
    "evidence_export": {"type": "object", "additionalProperties": false, "required": ["format", "input_sha256", "git_source_run_id", "evidence_source_run_id"], "properties": {"format": {"const": "review_package_v1"}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "git_source_run_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}, "evidence_source_run_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"},
    "check": {"type": "object", "additionalProperties": false, "required": ["check_id", "check_type", "status", "source_tool", "evidence_refs"], "properties": {"check_id": {"$ref": "#/$defs/identifier"}, "check_type": {"enum": ["test", "schema", "git", "manual"]}, "status": {"enum": ["passed", "failed", "not_run", "unknown"]}, "source_tool": {"enum": ["test_result_parser", "git_facts_collector", "evidence_package_builder", "none"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}}}
  }
}
