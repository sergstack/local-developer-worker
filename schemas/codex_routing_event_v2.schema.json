{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-developer-worker.invalid/schemas/codex_routing_event_v2.schema.json",
  "title": "Privacy-safe Codex routing calibration telemetry v2",
  "oneOf": [
    {"$ref": "#/$defs/v2_1"},
    {"$ref": "#/$defs/v2_2"},
    {"$ref": "#/$defs/v2_3"}
  ],
  "$defs": {
    "taskClass": {"enum": ["routine_read_or_docs", "bounded_change_or_debug", "cross_cutting_or_high_risk", "ambiguous"]},
    "profile": {"enum": ["efficient", "balanced", "frontier"]},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "common": {
      "type": "object",
      "required": ["record_type", "run_id", "routing_signal", "deterministic_risk_floor", "initial_profile", "initial_effort", "final_profile", "final_effort", "fallback_count", "escalation_count", "first_pass_verification_status", "final_verification_status", "terminal_status", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "latency_ms", "policy_revision", "routing_revision", "alias_revision", "taxonomy_revision"],
      "properties": {
        "record_type": {"const": "codex_routing_event_v2"},
        "run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "routing_signal": {"type": "string", "minLength": 1},
        "deterministic_risk_floor": {"$ref": "#/$defs/profile"},
        "initial_profile": {"$ref": "#/$defs/profile"}, "initial_effort": {"type": "string", "minLength": 1},
        "final_profile": {"$ref": "#/$defs/profile"}, "final_effort": {"type": "string", "minLength": 1},
        "fallback_count": {"type": "integer", "minimum": 0}, "escalation_count": {"type": "integer", "minimum": 0},
        "first_pass_verification_status": {"enum": ["passed", "failed", "uncertain", "not_run", "not_observed"]},
        "final_verification_status": {"enum": ["passed", "failed", "uncertain", "not_run"]}, "terminal_status": {"enum": ["pass", "failed", "blocked"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "latency_ms": {"type": "integer", "minimum": 0}, "policy_revision": {"$ref": "#/$defs/hash"}, "routing_revision": {"$ref": "#/$defs/hash"}, "alias_revision": {"$ref": "#/$defs/hash"}, "taxonomy_revision": {"$ref": "#/$defs/hash"}
      }
    },
    "v2_1": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "required": ["schema_version", "task_class"], "properties": {"schema_version": {"const": "2.1.0"}, "task_class": {"$ref": "#/$defs/taskClass"}}}
      ],
      "unevaluatedProperties": false
    },
    "v2_2": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "required": ["schema_version", "base_task_class", "routing_disposition", "override_requested_profile", "override_state", "adaptive_routing"], "properties": {
          "schema_version": {"const": "2.2.0"},
          "base_task_class": {"$ref": "#/$defs/taskClass"},
          "routing_disposition": {"enum": ["adaptive", "fixed_profile", "explicit_override", "override_rejected"]},
          "override_requested_profile": {"anyOf": [{"$ref": "#/$defs/profile"}, {"type": "null"}]},
          "override_state": {"enum": ["none", "accepted", "rejected"]},
          "adaptive_routing": {"type": "boolean"}
        }}
      ],
      "unevaluatedProperties": false
    },
    "v2_3": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "required": ["schema_version", "base_task_class", "routing_disposition", "override_requested_profile", "override_state", "adaptive_routing", "calibration_eligible"], "properties": {
          "schema_version": {"const": "2.3.0"},
          "base_task_class": {"$ref": "#/$defs/taskClass"},
          "routing_disposition": {"enum": ["adaptive", "fixed_profile", "explicit_override", "override_rejected"]},
          "override_requested_profile": {"anyOf": [{"$ref": "#/$defs/profile"}, {"type": "null"}]},
          "override_state": {"enum": ["none", "accepted", "rejected"]},
          "adaptive_routing": {"type": "boolean"},
          "calibration_eligible": {"type": "boolean"}
        }}
      ],
      "unevaluatedProperties": false
    }
  }
}
