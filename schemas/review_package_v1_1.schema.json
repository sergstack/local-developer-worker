{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPackageV1_1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "review_package_id", "objective", "diagnosis", "review_profile", "affected_invariants", "affected_boundaries", "required_checks", "findings", "unknowns", "evidence_refs", "derived_view_plan", "authority", "evidence_export", "evidence_ledger", "contract_delta"],
  "properties": {
    "contract_version": {"const": "1.1.0"}, "review_package_id": {"type": "string", "pattern": "^REVIEW_[0-9A-F]{12}$"}, "objective": {"type": "string"},
    "diagnosis": {"type": "object"}, "review_profile": {"enum": ["local", "contract_change", "cross_boundary", "evidence_risk"]}, "affected_invariants": {"type": "array"}, "affected_boundaries": {"type": "array"}, "required_checks": {"type": "array", "minItems": 1}, "findings": {"type": "array"}, "unknowns": {"type": "array"}, "evidence_refs": {"type": "array"},
    "derived_view_plan": {"type": "object", "additionalProperties": false, "required": ["views", "rendering", "authoritative_input"], "properties": {"views": {"type": "array"}, "rendering": {"const": "not_in_p1"}, "authoritative_input": {"const": "caller_retained_evidence"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["evidence_manifest_authoritative", "review_package_status", "promotion_authority", "model_invoked", "source_mutation", "root_cause_inferred"], "properties": {"evidence_manifest_authoritative": {"const": true}, "review_package_status": {"const": "derived"}, "promotion_authority": {"const": "human_or_ai_os_only"}, "model_invoked": {"const": false}, "source_mutation": {"const": false}, "root_cause_inferred": {"const": false}}},
    "evidence_export": {"type": "object", "additionalProperties": false, "required": ["format", "input_sha256", "git_source_run_id", "evidence_source_run_id"], "properties": {"format": {"const": "review_package_v1_1"}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "git_source_run_id": {"type": "string"}, "evidence_source_run_id": {"type": "string"}}},
    "evidence_ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "derived", "authoritative_input", "rows"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "derived": {"const": true},
        "authoritative_input": {"const": "caller_retained_evidence"},
        "rows": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["row_id", "kind", "state", "evidence_refs"],
            "properties": {
              "row_id": {"type": "string", "pattern": "^LEDGER_[A-Z][A-Z0-9_-]{0,63}$"},
              "kind": {"enum": ["evidence_reference", "required_check"]},
              "state": {"enum": ["observed", "candidate", "missing", "unknown", "not_run"]},
              "check_id": {"type": "string"},
              "status": {"enum": ["passed", "failed", "not_run", "unknown"]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "contract_delta": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "not_applicable"}, "reason": {"const": "no_contract_comparison_declared"}}}, {"type": "object", "additionalProperties": false, "required": ["status", "unavailable_reason_id"], "properties": {"status": {"const": "unavailable"}, "unavailable_reason_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}}}, {"type": "object", "additionalProperties": false, "required": ["status", "baseline", "candidate", "added_field_ids", "removed_field_ids", "changed_field_ids", "compatibility_assessment"], "properties": {"status": {"const": "structural_delta"}, "baseline": {"type": "object"}, "candidate": {"type": "object"}, "added_field_ids": {"type": "array"}, "removed_field_ids": {"type": "array"}, "changed_field_ids": {"type": "array"}, "compatibility_assessment": {"const": "not_in_p1"}}}]}
  }
}
