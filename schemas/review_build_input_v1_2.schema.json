{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewBuildInputV1_2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "objective", "scope", "git_facts", "evidence", "required_checks", "contract_comparison"],
  "properties": {
    "contract_version": {"const": "1.2.0"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 1000},
    "scope": {"type": "object"},
    "git_facts": {"$ref": "#/$defs/git_facts"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "required_checks": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "contract_comparison": {"type": ["object", "null"]}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"},
    "source_run_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "string", "pattern": "^RUN-[0-9a-f]{16}$"}]},
    "git_facts": {"type": "object", "additionalProperties": false, "required": ["source_tool", "source_run_id", "working_tree_clean", "changed_component_ids"], "properties": {"source_tool": {"const": "git_facts_collector"}, "source_run_id": {"$ref": "#/$defs/source_run_id"}, "working_tree_clean": {"type": "boolean"}, "changed_component_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source_tool", "source_run_id", "content_hash", "lineage_complete", "observed_evidence_refs", "candidate_evidence_refs", "missing_evidence_ids", "unknown_ids"], "properties": {"source_tool": {"const": "evidence_package_builder"}, "source_run_id": {"$ref": "#/$defs/source_run_id"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "lineage_complete": {"type": "boolean"}, "observed_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}, "candidate_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}, "missing_evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}, "unknown_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}}}
  }
}
