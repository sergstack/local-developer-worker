number"}, "failure_codes": {"type": "array", "items": {"enum": ["DIRECT_PATH_SUFFICIENT", "EXPAND_MISSING_DEPENDENCY", "EXPAND_MISSING_TEST_CONTEXT", "EXPAND_OTHER_BOUNDED_REASON", "REREAD_AFTER_COMPACTION", "ROUTE_UNDERSHOOT", "ROUTE_OVERSHOOT", "LOCAL_VERIFIER_REJECT", "LOCAL_RUNTIME_UNAVAILABLE", "FRONTIER_FALLBACK", "EXACT_SESSION_ESCALATION", "REPEATED_TOOL_READ", "STALE_CONTEXT_OR_EVIDENCE_REFRESH", "OTHER_OBSERVED"]}}, "policy_revision": {"$ref": "#/$defs/policy_revision"}}},
