{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OffloadEffectStudyInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "study_id", "mode", "evidence_status", "pairs"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "study_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"},
    "mode": {"enum": ["dry_run", "live"]},
    "evidence_status": {"enum": ["synthetic", "observed"]},
    "pairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pair"}}
  },
  "$defs": {
    "arm": {"type": "object", "additionalProperties": false, "required": ["route", "terminal_status", "verification_status", "accepted", "latency_ms", "provider_input_tokens", "provider_output_tokens", "context_bytes", "local_compute_ms", "fallback_count", "escalation_count", "failure_code", "policy_revision"], "properties": {"route": {"enum": ["local", "deterministic", "frontier", "blocked"]}, "terminal_status": {"enum": ["candidate_ready", "pass", "failed", "blocked"]}, "verification_status": {"enum": ["passed", "failed", "uncertain", "not_run", "schema_valid", "observed_success"]}, "accepted": {"type": ["boolean", "null"]}, "latency_ms": {"type": ["integer", "null"], "minimum": 0}, "provider_input_tokens": {"type": ["integer", "null"], "minimum": 0}, "provider_output_tokens": {"type": ["integer", "null"], "minimum": 0}, "context_bytes": {"type": ["integer", "null"], "minimum": 0}, "local_compute_ms": {"type": ["integer", "null"], "minimum": 0}, "fallback_count": {"type": "integer", "minimum": 0}, "escalation_count": {"type": "integer", "minimum": 0}, "failure_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}, "policy_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "pair": {"type": "object", "additionalProperties": false, "required": ["match_id", "task_class", "acceptance_source", "gold_accepted", "control", "candidate"], "properties": {"match_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}, "task_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "acceptance_source": {"enum": ["gold", "verifier", "none"]}, "gold_accepted": {"type": ["boolean", "null"]}, "control": {"$ref": "#/$defs/arm"}, "candidate": {"$ref": "#/$defs/arm"}}}
  }
}
