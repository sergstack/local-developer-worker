{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticClusterResult",
  "type": "object",
  "required": ["fallback_used", "fallback_reason", "observed_events", "semantic_groups", "model", "endpoint_policy"],
  "properties": {
    "fallback_used": {"type": "boolean"},
    "fallback_reason": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observed_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "level", "component", "message", "raw_hash", "raw_line_start", "raw_line_end", "parse_status", "origin"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^EV-[0-9]{6}$"},
          "level": {"type": "string"},
          "component": {"type": "string"},
          "message": {"type": "string"},
          "exception_type": {"type": ["string", "null"]},
          "source_file": {"type": ["string", "null"]},
          "source_line": {"type": ["integer", "null"], "minimum": 1},
          "raw_line_start": {"type": "integer", "minimum": 1},
          "raw_line_end": {"type": "integer", "minimum": 1},
          "raw_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "parse_status": {"enum": ["parsed", "part_of_event", "unknown_event", "unsupported_format", "parse_failed"]},
          "origin": {"const": "observed"}
        },
        "additionalProperties": false
      }
    },
    "semantic_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["group_id", "pattern", "classification", "source_span", "confidence", "origin", "needs_review"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^SG-[A-Z0-9_-]+$"},
          "pattern": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "minLength": 1},
          "source_span": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^EV-[0-9]{6}$"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "origin": {"const": "model-derived"},
          "needs_review": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "model": {"type": "string", "minLength": 1},
    "endpoint_policy": {"const": "loopback_only"}
  },
  "additionalProperties": false
}
