{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPackageV1_2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "review_package_id", "objective", "diagnosis", "review_profile", "affected_invariants", "affected_boundaries", "required_checks", "findings", "unknowns", "evidence_refs", "derived_view_plan", "authority", "evidence_export", "evidence_ledger", "contract_delta"],
  "properties": {
    "contract_version": {"const": "1.2.0"},
    "review_package_id": {"type": "string", "pattern": "^REVIEW_[0-9A-F]{12}$"},
    "objective": {"type": "string"},
    "diagnosis": {"type": "object"}, "review_profile": {"enum": ["local", "contract_change", "cross_boundary", "evidence_risk"]},
    "affected_invariants": {"type": "array"}, "affected_boundaries": {"type": "array"}, "required_checks": {"type": "array", "minItems": 1}, "findings": {"type": "array"}, "unknowns": {"type": "array"}, "evidence_refs": {"type": "array"},
    "derived_view_plan": {"type": "object"}, "authority": {"type": "object"}, "evidence_export": {"$ref": "#/$defs/evidence_export"}, "evidence_ledger": {"type": "object"}, "contract_delta": {"type": "object"}
  },
  "$defs": {
    "source_run_id": {"oneOf": [{"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"}, {"type": "string", "pattern": "^RUN-[0-9a-f]{16}$"}]},
    "evidence_export": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "input_sha256", "git_source_run_id", "evidence_source_run_id"],
      "properties": {
        "format": {"const": "review_package_v1_2"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_source_run_id": {"$ref": "#/$defs/source_run_id"},
        "evidence_source_run_id": {"$ref": "#/$defs/source_run_id"}
      }
    }
  }
}
