{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OffloadEffectStudyData",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "study_id", "mode", "evidence_status", "verdict", "review_status", "promotion_authority", "matched_task_ids", "pair_count", "complete_pair_count", "paired_metrics", "fallback_and_escalation", "safety", "evidence_export", "privacy"],
  "properties": {
    "contract_version": {"const": "1.0.0"}, "study_id": {"type": "string"}, "mode": {"enum": ["dry_run", "live"]}, "evidence_status": {"enum": ["synthetic", "observed"]}, "verdict": {"enum": ["INSUFFICIENT_EVIDENCE", "STOP", "READY_FOR_AI_OS_REVIEW"]}, "review_status": {"enum": ["INFORMATIONAL_ONLY", "SAFETY_REVIEW_REQUIRED", "NOT_ENOUGH_MATCHED_PAIRS", "EVIDENCE_EXPORT_READY"]}, "promotion_authority": {"const": "ai_os_only"}, "matched_task_ids": {"type": "array", "items": {"type": "string"}}, "pair_count": {"type": "integer", "minimum": 1}, "complete_pair_count": {"type": "integer", "minimum": 0}, "paired_metrics": {"type": "object"}, "fallback_and_escalation": {"type": "object"}, "safety": {"type": "object"}, "evidence_export": {"type": "object"}, "privacy": {"type": "object"}
  }
}
