{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-developer-worker.invalid/schemas/codex_run_data.schema.json",
  "title": "Codex run public data v1",
  "type": "object",
  "required": [
    "profile", "model_alias", "effort", "routing_signal", "routing_confidence",
    "deterministic_risk_floor", "policy_revision", "terminal_status", "verification_status",
    "fallback_count", "escalation_count", "input_tokens", "cached_input_tokens",
    "output_tokens", "reasoning_output_tokens"
  ],
  "properties": {
    "profile": {"type": ["string", "null"], "enum": ["efficient", "balanced", "frontier", null]},
    "model_alias": {"type": ["string", "null"]},
    "effort": {"type": ["string", "null"]},
    "routing_signal": {"type": ["string", "null"]},
    "routing_confidence": {"type": ["string", "null"], "enum": ["certain", "uncertain", null]},
    "deterministic_risk_floor": {"type": ["string", "null"], "enum": ["efficient", "balanced", "frontier", null]},
    "policy_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "terminal_status": {"enum": ["pass", "failed", "blocked"]},
    "verification_status": {"enum": ["passed", "failed", "uncertain", "not_run"]},
    "fallback_count": {"type": "integer", "minimum": 0},
    "escalation_count": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": false
}
