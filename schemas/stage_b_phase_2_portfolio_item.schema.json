{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StageBPhase2PortfolioItem",
  "type": "object",
  "required": ["id", "objective", "evidence_test_ids", "owner_action"],
  "properties": {
    "id": {"type": "string", "pattern": "^PB2-0[1-8]$"},
    "objective": {"type": "string", "minLength": 1},
    "evidence_test_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^tests/[^:]+::test_\\S+$"}
    },
    "owner_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
