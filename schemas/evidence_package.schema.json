{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidencePackage",
  "type": "object",
  "required": [
    "contract_version",
    "task",
    "repository_root",
    "repository_root_explicit",
    "evidence_items",
    "lineage_complete",
    "lineage_findings",
    "missing_evidence",
    "open_questions",
    "resume_state",
    "content_hash"
  ],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "task": {"type": "string"},
    "repository_root": {"type": "string", "minLength": 1},
    "repository_root_explicit": {"type": "boolean"},
    "evidence_items": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "lineage_complete": {"type": "boolean"},
    "lineage_findings": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "open_questions": {"type": "array"},
    "constraints": {"type": "array"},
    "context_package_reference": {"type": ["object", "null"]},
    "relevant_files": {"type": "array"},
    "test_statuses": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "error_groups": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "git_state": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "observed_facts": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "deterministic_derived": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "model_derived_candidates": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "resume_state": {
      "type": "object",
      "required": ["objective", "current_observed_state", "files_already_considered", "tests_actually_observed", "known_failures", "constraints", "missing_evidence", "next_bounded_action"],
      "properties": {
        "objective": {"type": "string"},
        "current_observed_state": {},
        "files_already_considered": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "tests_actually_observed": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
        "known_failures": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
        "constraints": {"type": "array"},
        "missing_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "next_bounded_action": {}
      }
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"lineage_complete": {"const": true}}},
      "then": {
        "properties": {
          "evidence_items": {"minItems": 1},
          "lineage_findings": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["evidence_type", "source_tool", "source_run_id", "source_type", "source_path", "event_id", "test_run_id", "git_observation_id", "origin", "value"],
      "properties": {
        "evidence_type": {"type": "string", "minLength": 1},
        "source_tool": {"type": ["string", "null"]},
        "source_run_id": {"type": ["string", "null"]},
        "source_type": {"type": ["string", "null"]},
        "source_path": {"type": ["string", "null"]},
        "event_id": {"type": ["string", "null"]},
        "test_run_id": {"type": ["string", "null"]},
        "git_observation_id": {"type": ["string", "null"]},
        "origin": {"enum": ["observed", "deterministic-derived", "model-derived-candidate", "user-provided", "unknown"]},
        "value": {}
      }
    }
  }
}
