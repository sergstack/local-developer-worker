{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-developer-worker.invalid/schemas/codex_run_event_v1.schema.json",
  "title": "Privacy-safe Codex run telemetry v1",
  "type": "object",
  "required": [
    "record_type", "schema_version", "run_id", "profile", "model_alias", "effort",
    "terminal_status", "verification_status", "fallback_count", "escalation_count",
    "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens"
  ],
  "properties": {
    "record_type": {"const": "codex_run_event_v1"},
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "profile": {"enum": ["efficient", "balanced", "frontier"]},
    "model_alias": {"type": "string", "minLength": 1},
    "effort": {"type": "string", "minLength": 1},
    "terminal_status": {"enum": ["pass", "failed", "blocked"]},
    "verification_status": {"enum": ["passed", "failed", "uncertain", "not_run"]},
    "fallback_count": {"type": "integer", "minimum": 0},
    "escalation_count": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": false
}
